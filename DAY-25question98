#include <stdio.h>

int main() {
    char str1[1000];
    char str2[1000];
    int freq1[256] = {0};
    int freq2[256] = {0};
    int i = 0;

    printf("Enter first string: ");
    scanf(" %[^\n]", str1);

    printf("Enter second string: ");
    scanf(" %[^\n]", str2);

    while (str1[i] != '\0') {
        freq1[(unsigned char)str1[i]]++;
        i++;
    }

    i = 0;
    while (str2[i] != '\0') {
        freq2[(unsigned char)str2[i]]++;
        i++;
    }

    printf("\nCommon characters: ");
    for (i = 0; i < 256; i++) {
        if (freq1[i] > 0 && freq2[i] > 0) {
            int common_count = (freq1[i] < freq2[i]) ? freq1[i] : freq2[i];
            for (int j = 0; j < common_count; j++) {
                printf("%c", i);
            }
        }
    }
    printf("\n");

    return 0;
}


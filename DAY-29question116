#include <stdio.h>

struct Item {
    int item_code;
    char name[30];
    int quantity;
    float price;
};

int main() {
    struct Item inventory[50];
    int count = 0, choice, i, target_code, quantity_change;

    while (1) {
        printf("\n*** Inventory Management System ***\n");
        printf("1. Add New Item\n");
        printf("2. Display Inventory Stock\n");
        printf("3. Update Stock Quantity\n");
        printf("4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                if (count < 50) {
                    printf("Enter Item Code: ");
                    scanf("%d", &inventory[count].item_code);
                    printf("Enter Item Name: ");
                    scanf(" %[^\n]", inventory[count].name);
                    printf("Enter Initial Quantity: ");
                    scanf("%d", &inventory[count].quantity);
                    printf("Enter Price per Unit: ");
                    scanf("%f", &inventory[count].price);
                    count++;
                    printf("Item logged into inventory successfully.\n");
                } else {
                    printf("Inventory storage configuration limit reached.\n");
                }
                break;
            case 2:
                if (count == 0) {
                    printf("Inventory contains no listed items.\n");
                } else {
                    printf("\n%-10s %-25s %-10s %-10s\n", "Code", "Name", "Quantity", "Price");
                    for (i = 0; i < count; i++) {
                        printf("%-10d %-25s %-10d $%-9.2f\n", inventory[i].item_code, inventory[i].name, inventory[i].quantity, inventory[i].price);
                    }
                }
                break;
            case 3:
                printf("Enter Item Code to modify: ");
                scanf("%d", &target_code);
                int item_found = 0;
                for (i = 0; i < count; i++) {
                    if (inventory[i].item_code == target_code) {
                        item_found = 1;
                        printf("Current quantity of %s is %d. Enter variance amount (positive to add, negative to subtract): ", inventory[i].name, inventory[i].quantity);
                        scanf("%d", &quantity_change);
                        if (inventory[i].quantity + quantity_change >= 0) {
                            inventory[i].quantity += quantity_change;
                            printf("Stock entry modified successfully.\n");
                        } else {
                            printf("Error: Operation would cause negative stock balance.\n");
                        }
                        break;
                    }
                }
                if (!item_found) {
                    printf("Specified Item Code not found.\n");
                }
                break;
            case 4:
                return 0;
            default:
                printf("Invalid choice code. Select a valid index.\n");
        }
    }
    return 0;
}


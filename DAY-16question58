#include <stdio.h>

int main() {
    int n, i, j;
    int max_element, max_count = 0;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    int arr[n];
    int visited[n];

    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++) {
        printf("Element %d: ", i + 1);
        scanf("%d", &arr[i]);
        visited[i] = 0;
    }

    max_element = arr[0];

    for (i = 0; i < n; i++) {
        if (visited[i] == 1) {
            continue;
        }

        int count = 1;
        for (j = i + 1; j < n; j++) {
            if (arr[i] == arr[j]) {
                count++;
                visited[j] = 1;
            }
        }

        if (count > max_count) {
            max_count = count;
            max_element = arr[i];
        }
    }

    printf("\nElement with maximum frequency = %d", max_element);
    printf("\nFrequency = %d\n", max_count);

    return 0;
}

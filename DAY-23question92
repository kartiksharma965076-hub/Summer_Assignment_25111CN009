#include <stdio.h>

int main() {
    char str[100];
    int freq[256] = {0};
    int i = 0;
    int max_count = 0;
    char max_char = '\0';

    printf("Enter a string: ");
    scanf("%[^\n]", str);

    while (str[i] != '\0') {
        freq[(unsigned char)str[i]]++;
        i++;
    }

    for (i = 0; i < 256; i++) {
        if (freq[i] > max_count) {
            max_count = freq[i];
            max_char = (char)i;
        }
    }

    if (max_count > 0) {
        printf("The maximum occurring character is '%c' with a frequency of %d.\n", max_char, max_count);
    } else {
        printf("The string is empty.\n");
    }

    return 0;
}


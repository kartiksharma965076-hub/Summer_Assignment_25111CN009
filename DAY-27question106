#include <stdio.h>

struct Employee {
    int emp_id;
    char name[50];
    char department[30];
};

int main() {
    int n, i;

    printf("Enter the number of employees: ");
    scanf("%d", &n);

    struct Employee e[n];

    for (i = 0; i < n; i++) {
        printf("\nEnter details for employee %d:\n", i + 1);
        printf("Employee ID: ");
        scanf("%d", &e[i].emp_id);
        printf("Name: ");
        scanf(" %[^\n]", e[i].name);
        printf("Department: ");
        scanf(" %[^\n]", e[i].department);
    }

    printf("\n*** Employee Records ***\n");
    printf("%-10s %-30s %-20s\n", "Emp ID", "Name", "Department");
    for (i = 0; i < n; i++) {
        printf("%-10d %-30s %-20s\n", e[i].emp_id, e[i].name, e[i].department);
    }

    return 0;
}


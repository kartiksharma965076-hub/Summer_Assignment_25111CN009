#include <stdio.h>
#include <string.h>

int main() {
    int n, i;

    printf("Enter number of students: ");
    scanf("%d", &n);

    int roll_no[n];
    char names[n][50];
    float marks[n];

    for (i = 0; i < n; i++) {
        printf("\nEnter details for student %d:\n", i + 1);
        printf("Roll Number: ");
        scanf("%d", &roll_no[i]);
        printf("Name: ");
        scanf(" %[^\n]", names[i]);
        printf("Marks: ");
        scanf("%f", &marks[i]);
    }

    printf("\n*** Student Records ***\n");
    printf("%-10s %-30s %-10s\n", "Roll No", "Name", "Marks");
    for (i = 0; i < n; i++) {
        printf("%-10d %-30s %-10.2f\n", roll_no[i], names[i], marks[i]);
    }

    return 0;
}


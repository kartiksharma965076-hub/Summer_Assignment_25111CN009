#include <stdio.h>
#include <string.h>

int main() {
    int emp_ids[50];
    char emp_names[50][50];
    float emp_salaries[50];
    int count = 0, choice, i, search_id, found;

    while (1) {
        printf("\n*** Mini Employee System ***\n");
        printf("1. Add Employee\n");
        printf("2. Display All Employees\n");
        printf("3. Search Employee\n");
        printf("4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                if (count < 50) {
                    printf("Enter Employee ID: ");
                    scanf("%d", &emp_ids[count]);
                    printf("Enter Name: ");
                    scanf(" %[^\n]", emp_names[count]);
                    printf("Enter Salary: ");
                    scanf("%f", &emp_salaries[count]);
                    count++;
                    printf("Employee profile stored.\n");
                } else {
                    printf("Storage limit reached.\n");
                }
                break;
            case 2:
                if (count == 0) {
                    printf("No records found.\n");
                } else {
                    printf("\n%-10s %-30s %-10s\n", "ID", "Name", "Salary");
                    for (i = 0; i < count; i++) {
                        printf("%-10d %-30s %-10.2f\n", emp_ids[i], emp_names[i], emp_salaries[i]);
                    }
                }
                break;
            case 3:
                printf("Enter Employee ID to search: ");
                scanf("%d", &search_id);
                found = 0;
                for (i = 0; i < count; i++) {
                    if (emp_ids[i] == search_id) {
                        printf("\nRecord Located:\nID: %d\nName: %s\nSalary: %.2f\n", 
                               emp_ids[i], emp_names[i], emp_salaries[i]);
                        found = 1;
                        break;
                    }
                }
                if (!found) {
                    printf("Employee not found.\n");
                }
                break;
            case 4:
                return 0;
            default:
                printf("Invalid option.\n");
        }
    }
    return 0;
}


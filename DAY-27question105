#include <stdio.h>

struct Student {
    int roll_no;
    char name[50];
    float marks;
};

int main() {
    int n, i;

    printf("Enter the number of students: ");
    scanf("%d", &n);

    struct Student s[n];

    for (i = 0; i < n; i++) {
        printf("\nEnter details for student %d:\n", i + 1);
        printf("Roll Number: ");
        scanf("%d", &s[i].roll_no);
        printf("Name: ");
        scanf(" %[^\n]", s[i].name);
        printf("Marks: ");
        scanf("%f", &s[i].marks);
    }

    printf("\n*** Student Records ***\n");
    printf("%-10s %-30s %-10s\n", "Roll No", "Name", "Marks");
    for (i = 0; i < n; i++) {
        printf("%-10d %-30s %-10.2f\n", s[i].roll_no, s[i].name, s[i].marks);
    }

    return 0;
}


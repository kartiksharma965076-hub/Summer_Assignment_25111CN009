#include <stdio.h>

int main() {
    int total_seats = 20, booked_seats = 0;
    int choice, requested_seats, seat_map[20] = {0}, i;

    while (1) {
        printf("\n*** Transit/Movie Ticket Booking Desk ***\n");
        printf("1. View Available Seats\n");
        printf("2. Book Seats\n");
        printf("3. Cancel Booking\n");
        printf("4. Exit Console\n");
        printf("Enter processing choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("\nSeat Grid Configuration Summary (0=Open, 1=Reserved):\n");
                for (i = 0; i < total_seats; i++) {
                    printf("[Seat %d: %d]  ", i + 1, seat_map[i]);
                    if ((i + 1) % 5 == 0) printf("\n");
                }
                printf("Total Seats Left: %d\n", total_seats - booked_seats);
                break;
            case 2:
                printf("How many seats would you like to request? ");
                scanf("%d", &requested_seats);
                if (requested_seats <= 0 || requested_seats > (total_seats - booked_seats)) {
                    printf("Requested allocation value exceeds actual seat inventory limits.\n");
                } else {
                    int counter = 0;
                    printf("Allocating Seats: ");
                    for (i = 0; i < total_seats && counter < requested_seats; i++) {
                        if (seat_map[i] == 0) {
                            seat_map[i] = 1;
                            printf("%d ", i + 1);
                            counter++;
                        }
                    }
                    booked_seats += requested_seats;
                    printf("\nTickets confirmed successfully!\n");
                }
                break;
            case 3:
                printf("Enter your assigned seat ID number to release/cancel: ");
                scanf("%d", &requested_seats);
                if (requested_seats < 1 || requested_seats > total_seats) {
                    printf("Invalid seating sector index specified.\n");
                } else if (seat_map[requested_seats - 1] == 0) {
                    printf("This seat location is already clear/vacant.\n");
                } else {
                    seat_map[requested_seats - 1] = 0;
                    booked_seats--;
                    printf("Seat position reservation cleared.\n");
                }
                break;
            case 4:
                return 0;
            default:
                printf("Selection choice parameter out of valid range bounds.\n");
        }
    }
    return 0;
}


#include <stdio.h>

int main() {
    int n1, n2, i, j, k, is_duplicate;

    printf("Enter the number of elements for first array: ");
    scanf("%d", &n1);

    int arr1[n1];
    printf("Enter %d elements:\n", n1);
    for (i = 0; i < n1; i++) {
        printf("Element %d: ", i + 1);
        scanf("%d", &arr1[i]);
    }

    printf("\nEnter the number of elements for second array: ");
    scanf("%d", &n2);

    int arr2[n2];
    printf("Enter %d elements:\n", n2);
    for (i = 0; i < n2; i++) {
        printf("Element %d: ", i + 1);
        scanf("%d", &arr2[i]);
    }

    int max_intersection_size = (n1 < n2) ? n1 : n2;
    int intersection_arr[max_intersection_size];
    k = 0;

    for (i = 0; i < n1; i++) {
        for (j = 0; j < n2; j++) {
            if (arr1[i] == arr2[j]) {
                is_duplicate = 0;
                for (int m = 0; m < k; m++) {
                    if (arr1[i] == intersection_arr[m]) {
                        is_duplicate = 1;
                        break;
                    }
                }
                if (!is_duplicate) {
                    intersection_arr[k] = arr1[i];
                    k++;
                }
                break;
            }
        }
    }

    printf("\nIntersection of the two arrays: ");
    if (k == 0) {
        printf("None");
    } else {
        for (i = 0; i < k; i++) {
            printf("%d ", intersection_arr[i]);
        }
    }
    printf("\n");

    return 0;
}

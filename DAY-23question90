#include <stdio.h>

int main() {
    char str[100];
    int freq[256] = {0};
    int i = 0;
    int found = 0;

    printf("Enter a string: ");
    scanf("%[^\n]", str);

    while (str[i] != '\0') {
        if (freq[(unsigned char)str[i]] == 1) {
            printf("The first repeating character is: %c\n", str[i]);
            found = 1;
            break;
        }
        freq[(unsigned char)str[i]]++;
        i++;
    }

    if (!found) {
        printf("No repeating character found.\n");
    }

    return 0;
}

